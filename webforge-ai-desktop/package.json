{
  "name": "webforge-ai-desktop",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.ts",
  "homepage": "./",
  "author": "WebForge AI Team",
  "description": "AI-powered font & site designer with Electron + React + FastAPI",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:vite\" \"npm run dev:python\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev:python": "cd python_backend && python main.py",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc electron/**/*.ts --outDir dist/electron",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^27.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  }
}
