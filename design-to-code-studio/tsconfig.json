{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": "."
  },
  "include": ["electron/**/*.ts", "frontend/src/**/*", "shared/**/*.ts", "vite.config.ts"]
}
