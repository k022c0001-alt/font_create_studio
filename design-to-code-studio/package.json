{
  "name": "design-to-code-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "node scripts/start-all.js",
    "dev:frontend": "vite --config vite.config.ts",
    "dev:electron": "wait-on http://localhost:5180 && electron .",
    "dev:python": "cd python_backend && python main.py",
    "build": "tsc && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "type-check": "tsc --noEmit",
    "test:backend": "cd .. && python3 -m pytest design-to-code-studio/tests"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^39.8.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.12",
    "wait-on": "^7.0.0"
  }
}
